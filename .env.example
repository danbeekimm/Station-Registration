# dustwatch 환경변수 목록. 복사해서 쓴다:  cp .env.example .env
#
# - docker compose는 같은 디렉터리의 .env를 자동으로 읽는다.
# - 서버·시뮬레이터는 run-server.sh / run-stations.sh가 .env를 읽어 준다. 직접 실행할 때는 export 하거나
#   `set -a; source .env; set +a` 뒤에 ./gradlew 를 실행한다.
# - 모두 기본값이 있으므로 이 파일 없이도 실행된다. 포트가 겹치거나 Slack을 쓸 때만 바꾸면 된다.
# - .env는 .gitignore 대상이다. 실제 Webhook URL이나 운영 토큰은 .env에만 둔다.

# ---- 포트 (평가 PC에서 이미 쓰는 포트가 있으면 여기만 바꾼다) ----
DUST_DB_PORT=5432          # PostgreSQL 호스트 포트. compose 포트 매핑과 서버 접속 URL이 함께 따라간다
DUST_HTTP_PORT=8080        # 대시보드(GET /), SSE(GET /stream), Actuator
DUST_TCP_PORT=9000         # 측정소 수신 포트. 시뮬레이터 기본 접속 주소(DUST_SERVER)도 이 값을 따른다

# ---- PostgreSQL 접속 ----
DUST_DB_HOST=localhost
DUST_DB_NAME=dust
DUST_DB_USER=dust
DUST_DB_PASSWORD=dust      # db/init.sql이 만드는 롤 비밀번호와 같아야 한다
# DUST_DB_URL=jdbc:postgresql://localhost:5432/dust   # 위 네 값 대신 전체 URL로 지정할 때만 사용

# ---- Slack ----
SLACK_WEBHOOK_URL=         # 비어 있으면 전송을 건너뛰고 alert_log.slack_status=SKIPPED로 기록
# DUST_DASHBOARD_URL=http://localhost:8080   # Slack 메시지의 대시보드 링크. 기본값은 DUST_HTTP_PORT를 따른다

# ---- 측정소 인증 토큰 (서버 시드와 run-stations.sh가 같은 값을 쓴다) ----
# 기본값은 개발·평가용 토큰이며 의도적으로 저장소에 포함되어 있다. 운영이라면 여기서 덮어쓴다.
STATION_TOKEN_111311=dev-token-nowon-111311
STATION_TOKEN_111121=dev-token-junggu-111121
STATION_TOKEN_111212=dev-token-gangseo-111212
STATION_TOKEN_111191=dev-token-eunpyeong-111191   # 은평구는 서버 시드에 없어 registerStation으로 등록해야 접속된다

# ---- 시뮬레이터 ----
# DUST_SERVER=localhost:9000   # 중앙 서버 주소. 기본값은 localhost:${DUST_TCP_PORT}
